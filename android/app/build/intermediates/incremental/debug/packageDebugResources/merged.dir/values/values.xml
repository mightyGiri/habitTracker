<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#03DAC5</color>
    <color name="colorPrimary">#6200EE</color>
    <color name="colorPrimaryDark">#3700B3</color>
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="launcher_background">#1E1F24</color>
    <color name="splash_background">#FFFFFF</color>
    <string name="app_name">Level-Up</string>
    <string name="custom_url_scheme">com.giri.levelup</string>
    <string name="package_name">com.giri.levelup</string>
    <string name="title_activity_main">Level-Up</string>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        
        <item name="android:fitsSystemWindows">false</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
    </style>
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="android:windowBackground">#0d1b3d</item>
        <item name="windowSplashScreenBackground">#0d1b3d</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">3000</item>
        <item name="windowSplashScreenIconBackgroundColor">#0d1b3d</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>