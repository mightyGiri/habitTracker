<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — dark, edge-to-edge with notch handling -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- No action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Transparent status bar so WebView content is properly inset -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <!-- Handle display cutouts (notch / punch-hole cameras) -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Ensure WebView fills properly -->
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
    </style>


    <!-- LaunchTheme moved to values/themes.xml and values-v31/themes.xml -->
</resources>
